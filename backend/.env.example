# CSCC Treasure Hunt — Backend Environment Configuration
PORT=3000
FRONTEND_ORIGIN=http://localhost:5500
ORGANIZER_PASSWORD=choose-a-strong-password
# Neon PostgreSQL connection string. Leave empty to store players in data/players.json
